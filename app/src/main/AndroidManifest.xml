<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ granular media permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Legacy permission for Android 8-12 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Needed only once Zoho cloud sync is switched on in a future version -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Viewer actions: wallpaper, contact avatar, PDF export on Android 8-9 -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <queries>
        <package android:name="com.vasudev.photoeditor" />
        <!-- The Nijatva family. Declaring them keeps the hand-offs working on
             Android 11+, where an app cannot see (or launch) packages it has not
             asked about. Missing ones simply fail over to the system chooser. -->
        <package android:name="com.nijatva.gallery" />
        <package android:name="com.nijatva.camera" />
        <package android:name="com.nijatva.photo.editor" />
        <package android:name="com.nijatva.videoplayer" />
        <package android:name="com.nijatva.music.player" />
        <package android:name="com.nijatva.file" />
        <package android:name="in.nijatva.browser" />
    </queries>

    <application
        android:name=".ZohoPhotosApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Photos"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZohoPhotos">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Be a gallery candidate, and accept a photo/video handed over by
                 Nijatva Gallery or Nijatva Camera. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_GALLERY" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- MyLensKit: visual search (web visual matches screen) -->
        <activity
            android:name="com.mylens.kit.BingVisionActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.nijatva.photos.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- MyLensKit: camera output + visual-search file chooser -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.mylens.kit.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mylens_file_paths" />
        </provider>
    </application>

</manifest>
